{
  "name": "luma-cabins",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --continue",
    "start": "turbo run start",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint:fix --continue",
    "lint:ws": "pnpm dlx sherif@latest",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format:fix --continue",
    "clean": "pnpm run clean:node_modules && pnpm run clean:cache && pnpm run clean:build",
    "clean:lock": "rimraf --glob **/package-lock.json **/pnpm-lock.yaml **/yarn.lock",
    "clean:node_modules": "rimraf --glob **/node_modules",
    "clean:cache": "rimraf --glob **/.cache **/.turbo",
    "clean:build": "rimraf --glob **/dist **/build **/.next",
    "postinstall": "pnpm lint:ws"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.100.1",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "^6.1.3",
    "turbo": "2.9.6",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.21.0",
    "pnpm": "^10.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
