                      "name": "Question",
                      "fill": "#F7F4EF",
                      "content": "Do I need to own land before contacting you?",
                      "fontFamily": "$--font-heading",
                      "fontSize": 18,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "XUNpJ",
                      "name": "Answer",
                      "fill": "#A9A5A0",
                      "content": "No. Many clients start with a general idea of location and we help clarify site requirements before anything is finalized.",
