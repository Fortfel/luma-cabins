                  "gap": 8,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "Rt5gz",
                      "name": "Question",
                      "fill": "$--foreground",
                      "content": "Can the cabins be installed off-grid?",
                      "fontFamily": "$--font-heading",
                      "fontSize": 18,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "OcjS7",
                      "name": "Answer",
                      "fill": "$--muted-foreground",
                      "content": "Yes, with an optional off-grid package. Solar-ready is standard; water storage and greater independence can be added.",
                      "lineHeight": 1.5,
                      "fontFamily": "$--font-sans",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
